@@ -937,6 +937,164 @@ int primordial_analytic_spectrum_init(
  * @return the error status
  */
 
+
+/* QNM helper: spherical Bessel j_2(x) */
+static double qnm_sph_bessel_j2(double x) {
+  if (fabs(x) < 1.0e-6) return x * x / 15.0;
+  double sinx = sin(x);
+  double cosx = cos(x);
+  double x2 = x * x;
+  return (3.0 / x2 - 1.0) * sinx / x - 3.0 * cosx / x2;
+}
+
+/* QNM P(k): bare mode sum with power-law weights and tilt correction */
+static double qnm_compute_pk(struct primordial * ppm, double k) {
+
+  // static const double omega_I_leaver[8] = {
+  //   0.08896, 0.27392, 0.47828, 0.70514, 0.95, 1.20, 1.45, 1.70310
+  // };
+
+  // /////////////////////////////////////////////////////////////////
+  // CPM correction
+  static const double omega_I_leaver[8] = {
+    0.08896, 0.27392, 0.47828, 0.70514, 0.95, 1.20, 1.45, 1.70310
+  };
+
+  /* Mode-dependent f from barrier formation dynamics (CPM, June 2026) */
+  static const double f_barrier[8] = {
+    0.181, 0.265, 0.469, 0.732, 0.930, 0.985, 0.997, 1.000
+  };
+  // /////////////////////////////////////////////////////////////////
+
+  // ////////////////////////////////////////////////
+  // qnm_weight_mode = 2
+  /* qnm_weight_mode == 2: per-mode weights from file (n, w_n) */
+  static double w_table[2048];
+  static int w_table_loaded = 0;
+  if (ppm->qnm_weight_mode == 2 && w_table_loaded == 0) {
+    FILE *wf = fopen(ppm->qnm_weight_file, "r");
+    if (wf == NULL) {
+      fprintf(stderr,
+        "QNM FATAL: qnm_weight_mode=2 but cannot open weight file '%s'\n",
+        ppm->qnm_weight_file);
+      exit(1);
+    }
+    int idx; double val; int count = 0;
+    while (fscanf(wf, "%d %lf", &idx, &val) == 2 && idx < 2048) {
+      w_table[idx] = val; count++;
+    }
+    fclose(wf);
+    if (count < ppm->qnm_N_modes) {
+      fprintf(stderr,
+        "QNM FATAL: weight file '%s' has %d entries, need %d\n",
+        ppm->qnm_weight_file, count, ppm->qnm_N_modes);
+      exit(1);
+    }
+    fprintf(stderr, "QNM: loaded %d weights from %s (w0=%g w1=%g w2=%g)\n",
+            count, ppm->qnm_weight_file, w_table[0], w_table[1], w_table[2]);
+    w_table_loaded = 1;
+  }
+  // ////////////////////////////////////////////////
+
+  double k0 = ppm->qnm_k0;
+  double beta = ppm->qnm_beta_geom;
+  int N = ppm->qnm_N_modes;
+  double gamma_val = ppm->qnm_gamma;
+
+  // //////////////////////////////////////////////
+  // Lifetime (Equipartition) Weighting Patch
+  // double w_sum = 0.0;
+  // int n;
+  // for (n = 0; n < N; n++) {
+  //   w_sum += 1.0 / pow((double)(n + 1), gamma_val);
+  // }
+  double w_sum = 0.0;
+  int n;
+  for (n = 0; n < N; n++) {
+    if (ppm->qnm_weight_mode == 2) {
+      w_sum += w_table[n];
+    } else if (ppm->qnm_weight_mode == 1) {
+      double oI = (n < 8) ? omega_I_leaver[n] : (2.0*n + 1.0) / 8.0;
+      w_sum += 1.0 / oI;
+    } else {
+      w_sum += 1.0 / pow((double)(n + 1), gamma_val);
+    }
+  }
+  // //////////////////////////////////////////////
+
+  double mode_sum = 0.0;
+  for (n = 0; n < N; n++) {
+    double kn = k0 * (double)(n + 1) * beta;
+    double omega_I_n = (n < 8) ? omega_I_leaver[n] : (2.0*n + 1.0) / 8.0;
+    double sigma_n = omega_I_n * k0 / (2.0 * _PI_);
+    // //////////////////////////////////////////////////////
+    // Lifetime (Equipartition) Weighting Patch
+    // double w_n = (1.0 / pow((double)(n + 1), gamma_val)) / w_sum;
+    double w_n;
+    if (ppm->qnm_weight_mode == 2) {
+      w_n = w_table[n] / w_sum;
+    } else if (ppm->qnm_weight_mode == 1) {
+      w_n = (1.0 / omega_I_n) / w_sum;
+    } else {
+      w_n = (1.0 / pow((double)(n + 1), gamma_val)) / w_sum;
+    }
+    // //////////////////////////////////////////////////////
+
+    double dk = k - kn;
+    // double lorentz = sigma_n * sigma_n / (dk * dk + sigma_n * sigma_n);
+
+    // ///////////////////////////////////////
+    // ALLOW CHANGES THROUGH INI
+    // double eps = dk / sigma_n;
+    // double eps2 = eps * eps;
+    // double L1 = 1.0 / (1.0 + eps2);
+    // double L2 = L1 * L1;
+    // double L_base = (1.0 - ppm->qnm_f_grey) * L1 + ppm->qnm_f_grey * L2;
+    // double lorentz = L_base * (1.0 - ppm->qnm_phase_delta * eps * L1);
+    // ///////////////////////////////////////
+    
+    // /////////////////////////////////////////////////////////////////
+     /* -----------------------------------------------------------
+     * Mode-dependent f(n) from barrier formation dynamics.
+     * f(omega_R) = 1 / (1 + (omega_R / 0.59)^6.4)
+     *
+     * Derived from CPM barrier formation model (June 7, 2026).
+     * At n=0 (omega=0.747): f=0.18
+     * At n=1 (omega=0.693): f=0.27  
+     * At n=2 (omega=0.602): f=0.47
+     * Asymptotic (omega=0.087): f≈1.0
+     *
+     * When qnm_f_grey < 0, use mode-dependent f.
+     * When qnm_f_grey >= 0, use constant f (backward compatible).
+     * ----------------------------------------------------------- */
+    double eps = dk / sigma_n;
+    double eps2 = eps * eps;
+    double L1 = 1.0 / (1.0 + eps2);
+    double L2 = L1 * L1;
+
+    double f_n;
+    if (ppm->qnm_f_grey < 0.0) {
+      /* Mode-dependent f from barrier formation (zero free parameters) */
+      f_n = (n < 8) ? f_barrier[n] : 1.0;
+    } else {
+      /* Constant f (backward compatible) */
+      f_n = ppm->qnm_f_grey;
+    }
+
+    double L_base = (1.0 - f_n) * L1 + f_n * L2;
+    double lorentz = L_base * (1.0 - ppm->qnm_phase_delta * eps * L1);
+    // /////////////////////////////////////////////////////////////////
+
+    double asym = (k + kn) * (k + kn) / (kn * kn);
+
+    mode_sum += w_n * lorentz * asym;
+  }
+
+  double pk = ppm->qnm_A * pow(k / 0.05, ppm->qnm_alpha) * mode_sum;
+  if (pk < 1.0e-30) pk = 1.0e-30;
+  return pk;
+}
